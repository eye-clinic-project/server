# ---- App ----
NODE_ENV="development"
PORT="9090"
FRONTEND_URL="http://localhost:3000"     # used in email links and as default CORS origin
# CORS_ORIGIN="http://localhost:3000,https://app.example.com"
MAINTENANCE_MODE=false

# ---- Data ----
DATABASE_URI="mongodb://127.0.0.1:27017/retinacare"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_URI="redis://..."

# ---- Security ----
ENCRYPTION_KEY=""            # openssl rand -base64 32  (encrypts stored images, signs file URLs)
ACCESS_TOKEN_EXPIRES_IN="900"
REFRESH_TOKEN_EXPIRES_IN="604800"
ACCESS_USER_TOKEN_SIGNATURE=""   # openssl rand -hex 32
REFRESH_USER_TOKEN_SIGNATURE=""  # openssl rand -hex 32
AUTH_ISSUER="http://localhost:3000"
OAUTH_GOOGLE_CLIENT_ID=""

# First admin, created on startup if it does not exist
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me"

# ---- Email (Gmail app password, or SMTP_* for any server) ----
APP_NAME="RetinaCare"
APP_MAIL=""
APP_PASSWORD=""
# SMTP_HOST= SMTP_PORT=587 SMTP_SECURE=false SMTP_USER= SMTP_PASSWORD= MAIL_FROM=
# Without email config, development logs emails (incl. OTP codes) to the console.

# ---- Storage ----
STORAGE_DIR="storage"        # private, encrypted at rest; never served statically
MAX_IMAGE_SIZE_MB="10"

# ---- AI service (FastAPI in /core) ----
AI_MODE="disabled"           # disabled | mock | remote
# AI_SERVICE_URL="http://127.0.0.1:8000"
# AI_SERVICE_API_KEY=""
AI_TIMEOUT_MS="20000"
